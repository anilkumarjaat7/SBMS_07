<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <title>Home | SB Coaching Institute</title>
    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>
<!-- Nav Bar -->
<nav class="navbar">
    <div class="nav-brand">
        <a th:href="@{/}">SB Coaching Institute</a>
    </div>
    <div class="nav-links">
        <a th:href="@{/}">Home</a>
        <a th:href="@{/courses}">Courses</a>
        <a th:href="@{/reviews}">Reviews</a>
        <a th:href="@{/about}">About</a>
        <a th:href="@{/students}">Students</a>
        <a class="btn-nav" th:href="@{/dashboard}">Dashboard</a>
    </div>
</nav>


<div class="form-container">

    <h1>Student Form</h1>

    <form
        th:action="@{/students/save}"
        th:object="${student}"
        method="post">


        <input
            type="hidden"
            th:field="*{id}">


        <label>Name</label>

        <input
            type="text"
            th:field="*{name}"
            placeholder="Enter name">


        <label>Email</label>

        <input
            type="text"
            th:field="*{email}"
            placeholder="Enter email">


        <label>City</label>

        <input
            type="text"
            th:field="*{city}"
            placeholder="Enter city">
            
                    <label>Age</label>
             <input type="number"
               th:field="*{age}"
               placeholder="Enter age">


        <button type="submit">
            Save Student
        </button>

    </form>

    <br>

    <a th:href="@{/students}">
        Back
    </a>

</div>




<footer class="footer">
    <p>&#169; 2026 SB Coaching Institute</p>
</footer>

</body>
</html> 