package com.p1.student.controller;

import java.util.List;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;

import com.p1.student.entity.Student;
import com.p1.student.repository.StudentRepository;

@Controller

public class StudentController {
	
	

	private StudentRepository repo;
	
	
	public StudentController(StudentRepository repo) {
		super();
		this.repo = repo;
	}




	@GetMapping("/students")
	public String Students(Model model) {
		
//		model.addAttribute("name", "ashok Kumar");
//		model.addAttribute("age", "2");
//		model.addAttribute("city", "Jaipur");
		
		List<Student> stu = repo.findAll();
		
		model.addAttribute("students", stu);
		return "Students";
	}

}
