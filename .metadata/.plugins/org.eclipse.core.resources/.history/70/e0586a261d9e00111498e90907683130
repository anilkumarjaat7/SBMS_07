package com.p1.repository;

import java.util.List;

import org.springframework.data.jpa.repository.JpaRepository;

import com.nilu.entity.Review;

public interface ReviewRepository
        extends JpaRepository<Review, Integer> {

    List<Review> findAllByOrderByCreatedDateDesc();

    List<Review> findByCourseNameContainingIgnoreCaseOrderByCreatedDateDesc(
            String courseName);
}