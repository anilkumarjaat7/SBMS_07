<html lang="en">
<head>

</head>
<body>
	<form th:action="@{/student/save}"    th:object="${student}" method="post">


		<input type="hidden" th:field="*{id}"> <label>Name</label> <input
			type="text" th:field="*{name}" placeholder="Enter name"> <label>Email</label>

		<input type="text" th:field="*{email}" placeholder="Enter email">


		<label>City</label> <input type="text" th:field="*{city}"
			placeholder="Enter city">


		<button type="submit">Save Student</button>

	</form>
</body>
</html>
