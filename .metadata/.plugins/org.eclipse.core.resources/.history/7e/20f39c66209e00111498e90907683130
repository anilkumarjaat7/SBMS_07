<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>

<title>Student Form</title>

<link rel="stylesheet" th:href="@{/css/style.css}">

</head>

<body>

	<nav class="navbar">
		<div class="nav-brand">
			<a th:href="@{/}">SB Coaching Institute</a>
		</div>
		<div class="nav-links">
			<a th:href="@{/}">Home</a> <a th:href="@{/courses}">Courses</a> <a
				th:href="@{/reviews}">Reviews</a> <a th:href="@{/about}">About</a> <a
				th:href="@{/students}">Students</a> <a class="btn-nav"
				th:href="@{/dashboard}">Dashboard</a>
		</div>
	</nav>

	<div class="form-container">

		<h1>Student Form</h1>


		<form th:action="@{/student/save}" th:object="${student}"
			method="post">


			<!-- ID -->

			<input type="hidden" th:field="*{id}">


			<!-- Name -->

			<label>Name</label> <input type="text" th:field="*{name}"
				placeholder="Enter name">


			<!-- Email -->

			<label>Email</label> <input type="email" th:field="*{email}"
				placeholder="Enter email">


			<!-- City -->

			<label>City</label> <input type="text" th:field="*{city}"
				placeholder="Enter city">


			<!-- Age -->

			<label>Age</label> <input type="number" th:field="*{age}"
				placeholder="Enter age">


			<button type="submit">Save Student</button>

		</form>


		<br> <a th:href="@{/students}"> Back </a>

	</div>

</body>

</html>